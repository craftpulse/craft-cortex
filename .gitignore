/vendor/
/composer.lock
/.phpunit.result.cache
/.phpunit.cache/

# Personal Claude Code settings (per-developer permissions, not shared)
/.claude/settings.local.json
/.claude/memory/
/.claude/scheduled_tasks.lock

# Internal agent operating rules and review-prompt templates, local only
/.claude/rules/
/.claude/prompts/

# Internal dev knowledge — full gate-by-gate history, audit findings,
# smoke results, anything that's "our knowledge" rather than user-facing
# documentation. Each developer keeps their own.
/.internal/
/docs/plans/

# AI-assisted smoke-run checklists and evidence, local only
/smoke-testing/

# Internal review notes and session handoffs, local only
/CLAUDE.md
/.session-handoff.md
/docs/REVIEW.md
/docs/review/
/docs/SMOKE-TEST.md
/docs/smoke-evidence/

# Internal dependency heads-up notes, local only
/plans/

# OAuth JWT key pair (generated by `herald/oauth/init-keys`). The
# keys live under the host Craft install's storage path
# (storage/herald/oauth-keys/), not in this repo — the ignore line
# is defensive in case the dev environment ever generates them
# locally.
/storage/herald/oauth-keys/

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.swp
*.swo
