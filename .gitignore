/vendor/
/composer.lock
/.phpunit.result.cache
/.phpunit.cache/

# Personal Claude Code settings (per-developer permissions, not shared)
/.claude/settings.local.json
/.claude/memory/

# Internal dev knowledge — full gate-by-gate history, audit findings,
# smoke results, anything that's "our knowledge" rather than user-facing
# documentation. Each developer keeps their own.
/.internal/

# OAuth JWT key pair (generated by `cortex/oauth/init-keys`). The
# keys live under the host Craft install's storage path
# (storage/cortex/oauth-keys/), not in this repo — the ignore line
# is defensive in case the dev environment ever generates them
# locally.
/storage/cortex/oauth-keys/

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.swp
*.swo
