# PHPStan config for herald.
#
# Run from the playground:
#
#   ddev exec --dir=/var/www/html/cms vendor/bin/phpstan analyse \
#     --memory-limit=1G -c vendor/craftpulse/craft-herald/phpstan.neon
#
# Level 8 — fully strict. The lean exclusions below cover patterns
# where Craft / Yii's stubs are conservatively typed but the real
# runtime values are non-null (e.g. `Section::$handle` typed as
# `?string` though never null in practice).

includes:
    - /var/www/html/cms/vendor/craftcms/phpstan/phpstan.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - tests/Bootstrap.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Tools take MCP-shaped `array<string,mixed>` arguments. Annotating
        # every private helper that re-receives that array adds noise
        # without surfacing real issues.
        - identifier: missingType.iterableValue
          path: src/tools/*

        # Herald::config() returns Yii's generic component-config array;
        # the schema isn't worth pinning down for one method.
        - identifier: missingType.iterableValue
          path: src/Herald.php

        # Craft's element-query classes use generic templates we don't
        # need to forward in private builder helpers.
        - identifier: missingType.generics
          path: src/tools/content/*

        # `Element::find()` returns its concrete element-query class —
        # Herald's `Skill::find()` mirrors Craft's `Tag::find()` shape
        # (`@return TagQuery` without template parameters). Forwarding
        # the generics on a public `find()` override leaks Element's
        # internal `TKey/TElement` covariance constraints into Herald
        # callers and conflicts with Element's non-covariant template
        # types. The query class itself does declare templates on its
        # own docblock.
        - identifier: missingType.generics
          path: src/elements/Skill.php

