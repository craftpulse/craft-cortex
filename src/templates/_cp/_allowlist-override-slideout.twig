{% import "_includes/forms.twig" as forms %}

{# =========================================================================
   Guided temporary-grant issuance slideout body partial.

   Rendered by `actionAllowlistOverrideSlideout` and fetched via
   `Craft.sendActionRequest('GET', 'herald/settings/allowlist-override-slideout')`
   from `Herald.openAllowlistOverrideSlideout()`. The returned HTML is
   passed into `new Craft.Slideout(html, {containerElement: 'form', ...})`
   so the slideout container provides the `<form>` shell.

   The guided flow (per the grant redesign spec):
     1. User picker      — the subject the grant is FOR (`subjectUserId`).
     2. Command picker    — a searchable grouped list; each checkbox posts a
                            pattern into `patterns[]` (a whole group `group/*`
                            or an exact route id).
     3. Duration presets  — 1h / 8h / 24h / 7d / custom (`durationPreset`,
                            `customTtlSeconds`).
     4. Reason            — optional free text (`note`).

   No `<html>` / `<body>` chrome — pure fragment. `data-herald-form` is the
   JS hook the slideout listener finds; the CSRF token is rendered inline
   because the slideout's form shell does not auto-inject it. The command
   picker uses native `<details>` for independent expand/collapse (no shared
   JS disclosure state); `Herald._wireGrantSlideout()` adds the live filter
   and the group/action checkbox cascade.
   ========================================================================= #}

<div class="so-body" data-herald-form>
    <header class="pane-header">
        <h2 class="screen-title">{{ 'Issue grant'|t('herald') }}</h2>
    </header>

    <div class="so-content padded">
        <p class="light">
            {{ 'Grant a user time-bound access to run additional {tool} commands. The grant applies only to the chosen user and expires automatically.'|t('herald', { tool: '<code>craft_command</code>' })|raw }}
        </p>

        {{ csrfInput() }}

        {{ forms.elementSelectField({
            label: 'User'|t('herald'),
            instructions: 'The user this grant applies to. Only this user gains the granted commands.'|t('herald'),
            id: 'herald-grant-subject',
            name: 'subjectUserId',
            elementType: 'craft\\elements\\User',
            limit: 1,
            required: true,
        }) }}

        {{ forms.field({
            label: 'Commands'|t('herald'),
            instructions: 'Pick one or more command scopes. A group checkbox grants the whole group (group/*); expand a group to grant exact routes. fnmatch semantics apply.'|t('herald'),
            required: true,
        }, '') }}

        <div class="herald-grant-commands" data-herald-grant-commands>
            <div class="herald-command-search">
                <div class="texticon search icon clearable">
                    <input
                        type="text"
                        class="text fullwidth"
                        autocomplete="off"
                        data-herald-grant-filter
                        placeholder="{{ 'Filter commands'|t('herald') }}"
                        aria-label="{{ 'Filter commands'|t('herald') }}"
                    >
                </div>
            </div>

            <div class="herald-command-groups">
                {% for handle, group in commandGroups %}
                    {% set ids = group.actions|map(a => a.id) %}
                    {% set groupGlob = (ids|length == 1 and ids[0] == handle) ? handle : handle ~ '/*' %}
                    <details class="herald-command-group" data-herald-grant-group data-group-handle="{{ handle }}">
                        <summary class="herald-command-group-header">
                            <span class="herald-command-group-caret" aria-hidden="true"></span>
                            <span class="herald-command-group-switch" data-herald-grant-group-control>
                                <input
                                    type="checkbox"
                                    name="patterns[]"
                                    value="{{ groupGlob }}"
                                    data-herald-grant-group-cb
                                    aria-label="{{ 'Grant the whole {group} group'|t('herald', { group: handle }) }}"
                                >
                            </span>
                            <span class="herald-command-group-name">{{ handle }}</span>
                            <span class="herald-command-group-source light">{{ group.source }}</span>
                        </summary>

                        <div class="herald-command-actions">
                            {% for action in group.actions %}
                                <label class="herald-command-action" data-herald-grant-action data-route-id="{{ action.id }}">
                                    <input type="checkbox" name="patterns[]" value="{{ action.id }}" data-herald-grant-action-cb>
                                    <code class="herald-token-prefix">{{ action.id }}</code>
                                </label>
                            {% endfor %}
                        </div>
                    </details>
                {% endfor %}
            </div>
        </div>

        {{ forms.selectField({
            label: 'Duration'|t('herald'),
            instructions: 'How long the grant stays active before it expires automatically.'|t('herald'),
            id: 'herald-grant-duration',
            name: 'durationPreset',
            value: '86400',
            options: [
                { label: '1 hour'|t('herald'), value: '3600' },
                { label: '8 hours'|t('herald'), value: '28800' },
                { label: '24 hours'|t('herald'), value: '86400' },
                { label: '7 days'|t('herald'), value: '604800' },
                { label: 'Custom'|t('herald'), value: 'custom' },
            ],
        }) }}

        {{ forms.textField({
            label: 'Custom duration (seconds)'|t('herald'),
            instructions: 'Used only when Duration is set to Custom. Minimum 60.'|t('herald'),
            id: 'herald-grant-custom-ttl',
            name: 'customTtlSeconds',
            type: 'number',
            min: 60,
            placeholder: settings.getRuntimeOverrideTtl(),
        }) }}

        {{ forms.textareaField({
            label: 'Reason'|t('herald'),
            instructions: 'Optional. Surfaces in the audit history and the grants table.'|t('herald'),
            id: 'herald-grant-note',
            name: 'note',
            rows: 2,
            placeholder: 'ticket-1234'|t('herald'),
        }) }}
    </div>

    <footer class="so-footer">
        <div class="flex flex-nowrap">
            <button type="button" class="btn" data-herald-cancel>{{ 'Cancel'|t('app') }}</button>
            <div class="flex-grow"></div>
            <button type="submit" class="btn submit" data-herald-submit>{{ 'Issue grant'|t('herald') }}</button>
        </div>
    </footer>
</div>
