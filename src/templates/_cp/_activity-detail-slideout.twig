{# =========================================================================
   Activity-detail slideout body partial.

   Rendered by `SettingsController::actionActivityRow` and fetched via
   `Craft.sendActionRequest('GET', 'herald/settings/activity-row', {params: {id}})`
   from `Herald.openActivityDetailSlideout()`. The returned HTML is passed
   into `new Craft.Slideout(html, {...})`.

   Shows ONLY already-redacted columns (locked decision 11):
     - metadata table (tool, mode, kind, duration, transport, client,
       session, request id, rate-limit remaining)
     - `argsRedacted`     — pretty-printed JSON (post-SecretRedactor)
     - `responseExcerpt`  — pretty-printed (when present)
     - error class + message (tool_error / internal_error)
     - cancellation reason (cancelled — sourced from errorMessage)

   There is NO pre-redaction surface anywhere in the data path — those
   payloads were never persisted. No `<html>`/`<body>` chrome — the
   slideout container supplies it.

   Context:
     - `row`  : the raw `herald_invocations` row (associative array).
     - `user` : `{id, label, cpEditUrl}` or null.
   ========================================================================= #}

{% set kind = row.kind is defined ? row.kind : '' %}

{# `mode`, `argsPretty`, and `responsePretty` arrive pre-computed from
   `actionActivityRow` — the decode is PHP-side with a try/catch because
   the `responseExcerpt` column is clipped by the logger and frequently
   is NOT valid JSON. Twig's `|json_decode` (`Json::decode`) throws on a
   truncated excerpt instead of falling through (gate-9 browser smoke). #}

<div class="so-body" data-herald-activity-detail>
    <header class="pane-header">
        <h2 class="screen-title">{{ '{tool} activity'|t('herald', { tool: row.toolName ?? 'tool call'|t('herald') }) }}</h2>
    </header>

    <div class="so-content padded">
        {# ---- Metadata ------------------------------------------------- #}
        <div class="herald-meta-grid">
            <dl>
                <dt>{{ 'Tool'|t('herald') }}</dt>
                <dd><code>{{ row.toolName ?? '-' }}</code></dd>

                {% if mode %}
                    <dt>{{ 'Mode'|t('herald') }}</dt>
                    <dd><code>{{ mode }}</code></dd>
                {% endif %}

                <dt>{{ 'Kind'|t('herald') }}</dt>
                <dd><span class="herald-status herald-status--{{ kind|replace({'_': '-'}) }}">{{ kind }}</span></dd>

                <dt>{{ 'User'|t('herald') }}</dt>
                <dd>
                    {% if user %}
                        <a href="{{ user.cpEditUrl }}">{{ user.label }}</a>
                    {% else %}
                        <span class="light">{{ 'Anonymous'|t('herald') }}</span>
                    {% endif %}
                </dd>

                <dt>{{ 'Duration'|t('herald') }}</dt>
                <dd>{{ row.durationMs ?? 0 }}ms</dd>

                <dt>{{ 'Transport'|t('herald') }}</dt>
                <dd>{{ row.transport ?? '-' }}</dd>

                <dt>{{ 'Client'|t('herald') }}</dt>
                <dd>{{ row.clientName ?? '-' }}</dd>

                {% if row.sessionId is defined and row.sessionId %}
                    <dt>{{ 'Session'|t('herald') }}</dt>
                    <dd><code>{{ row.sessionId }}</code></dd>
                {% endif %}

                {% if row.requestId is defined and row.requestId %}
                    <dt>{{ 'Request ID'|t('herald') }}</dt>
                    <dd><code>{{ row.requestId }}</code></dd>
                {% endif %}

                {% if row.rateLimitRemaining is defined and row.rateLimitRemaining is not null %}
                    <dt>{{ 'Rate limit remaining'|t('herald') }}</dt>
                    <dd>{{ row.rateLimitRemaining }}</dd>
                {% endif %}

                <dt>{{ 'When'|t('herald') }}</dt>
                <dd>{{ row.dateCreated ? row.dateCreated|datetime('short') : '-' }}</dd>
            </dl>
        </div>

        {# ---- Error / cancellation context ----------------------------- #}
        {% set errorClass = row.errorClass is defined ? row.errorClass : null %}
        {% set errorMessage = row.errorMessage is defined ? row.errorMessage : null %}

        {% if kind in ['tool_error', 'internal_error'] and (errorClass or errorMessage) %}
            <div class="field">
                <div class="heading"><label>{{ 'Error'|t('herald') }}</label></div>
                <div class="input">
                    {% if errorClass %}
                        <p><code>{{ errorClass }}</code></p>
                    {% endif %}
                    {% if errorMessage %}
                        <blockquote class="note" role="alert">{{ errorMessage }}</blockquote>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {% if kind == 'cancelled' and errorMessage %}
            <div class="field">
                <div class="heading"><label>{{ 'Cancellation reason'|t('herald') }}</label></div>
                <div class="input">
                    <blockquote class="note" role="status">{{ errorMessage }}</blockquote>
                </div>
            </div>
        {% endif %}

        {# ---- Redacted request args ------------------------------------ #}
        <div class="field">
            <div class="heading"><label>{{ 'Request (redacted)'|t('herald') }}</label></div>
            <div class="input">
                {% if argsPretty %}
                    <pre class="herald-payload"><code>{{ argsPretty }}</code></pre>
                {% else %}
                    <p class="light">{{ 'No arguments recorded.'|t('herald') }}</p>
                {% endif %}
            </div>
        </div>

        {# ---- Redacted response excerpt -------------------------------- #}
        {% if responsePretty %}
            <div class="field">
                <div class="heading"><label>{{ 'Response excerpt (redacted)'|t('herald') }}</label></div>
                <div class="input">
                    <pre class="herald-payload"><code>{{ responsePretty }}</code></pre>
                </div>
            </div>
        {% endif %}
    </div>

    <footer class="so-footer">
        <div class="flex flex-nowrap">
            <div class="flex-grow"></div>
            <button type="button" class="btn submit" data-herald-done>{{ 'Done'|t('app') }}</button>
        </div>
    </footer>
</div>
