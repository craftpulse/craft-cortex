{% extends "herald/_cp/_layout" %}
{% import "_includes/forms.twig" as forms %}

{# =========================================================================
   Herald Activity tab — VueAdminTable of the HTTP-transport invocation
   audit log + filter bar + row-click Garnish.Slideout detail.

   The log records one row per authenticated Streamable-HTTP `tools/call`.
   Admins audit every row; non-admins granted `herald:view-activity` see
   ONLY their own rows — the scope is enforced server-side in
   `SettingsController::actionActivityTableData` and cannot be widened by
   the `filters[userId]` param (fail-closed, decision 7).

   Data path:
     - Table data : GET herald/settings/activity-table-data → JSON {pagination, data}
     - Row detail : GET herald/settings/activity-row?id=<id> → JSON {html}

   The row shape is locked in `RowSerializer::serializeActivity`:
   `{id, tool: {id, tool, mode}, kind, user, durationMs, dateCreated}` —
   the tool cell is a composite because VueAdminTable column callbacks
   receive only the cell value, never the row.

   Filter values are passed in from the controller:
     - `kinds`     : the five audit-kind enum values.
     - `toolNames` : distinct tool names across the table.
     - `isAdmin`   : gates the user-id filter (non-admins are self-scoped).

   The detail slideout never displays anything beyond the already-redacted
   `argsRedacted` / `responseExcerpt` columns (decision 11) — there is no
   pre-redaction surface anywhere in the data path.
   ========================================================================= #}

{% set selectedSubnavItem = 'activity' %}

{% do view.registerTranslations('herald', [
    'All kinds',
    'All tools',
    'Anonymous',
    'Could not open the activity detail.',
    'Duration',
    'From',
    'Kind',
    'No activity recorded yet.',
    'Search activity',
    'Tool',
    'To',
    'User',
    'When',
    'cancelled',
    'internal_error',
    'rate_limited',
    'success',
    'tool_error',
]) %}

{% block content %}
    <p class="light">
        {{ 'Audit log of authenticated Streamable HTTP tool calls. Click a row to inspect the redacted request and response payloads.'|t('herald') }}
    </p>

    <div id="herald-activity-filters" class="flex flex-nowrap" style="margin-bottom: 14px; gap: 10px; flex-wrap: wrap;">
        <div class="field">
            <div class="heading">
                <label for="herald-activity-filter-kind">{{ 'Kind'|t('herald') }}</label>
            </div>
            <div class="input">
                {{ forms.select({
                    id: 'herald-activity-filter-kind',
                    name: 'kind',
                    options: [{ label: 'All kinds'|t('herald'), value: '' }]|merge(
                        kinds|map(k => { label: k|t('herald'), value: k })
                    ),
                }) }}
            </div>
        </div>

        <div class="field">
            <div class="heading">
                <label for="herald-activity-filter-tool">{{ 'Tool'|t('herald') }}</label>
            </div>
            <div class="input">
                {{ forms.select({
                    id: 'herald-activity-filter-tool',
                    name: 'toolName',
                    options: [{ label: 'All tools'|t('herald'), value: '' }]|merge(
                        toolNames|map(t => { label: t, value: t })
                    ),
                }) }}
            </div>
        </div>

        {% if isAdmin %}
            <div class="field">
                <div class="heading">
                    <label for="herald-activity-filter-user">{{ 'User'|t('herald') }}</label>
                </div>
                <div class="input">
                    {{ forms.elementSelect({
                        id: 'herald-activity-filter-user',
                        name: 'userId',
                        elementType: 'craft\\elements\\User',
                        limit: 1,
                        selectionLabel: 'Choose a user'|t('herald'),
                    }) }}
                </div>
            </div>
        {% endif %}

        <div class="field">
            <div class="heading">
                <label for="herald-activity-filter-from">{{ 'From'|t('herald') }}</label>
            </div>
            <div class="input">
                {{ forms.date({
                    id: 'herald-activity-filter-from',
                    name: 'from',
                }) }}
            </div>
        </div>

        <div class="field">
            <div class="heading">
                <label for="herald-activity-filter-to">{{ 'To'|t('herald') }}</label>
            </div>
            <div class="input">
                {{ forms.date({
                    id: 'herald-activity-filter-to',
                    name: 'to',
                }) }}
            </div>
        </div>
    </div>

    <div id="herald-activity-vue-admin-table"></div>
{% endblock %}

{% js %}
    (function() {
        var tableContainer = '#herald-activity-vue-admin-table';

        // Collect the current filter values into the `criteria` object the
        // VueAdminTable forwards as query params. Reads the live DOM each
        // call so a filter change + reload always sends fresh values.
        function currentFilters() {
            function val(selector) {
                var el = document.querySelector(selector);
                return el ? el.value : '';
            }
            // The user element-select posts its id under `fields[...][]` —
            // read the hidden input the Garnish element-select maintains.
            var userId = '';
            var userInput = document.querySelector('#herald-activity-filter-user input[name="userId[]"]');
            if (userInput) {
                userId = userInput.value;
            }
            return {
                kind: val('#herald-activity-filter-kind'),
                toolName: val('#herald-activity-filter-tool'),
                userId: userId,
                from: val('#herald-activity-filter-from'),
                to: val('#herald-activity-filter-to'),
            };
        }

        function renderToolCell(value) {
            // VueAdminTable callbacks receive ONLY the cell value — the
            // controller serialises a `{id, tool, mode}` composite so the
            // detail-trigger id and mode suffix travel inside the value.
            var tool = value && value.tool ? Craft.escapeHtml(value.tool) : Craft.t('herald', 'tool call');
            if (value && value.mode) {
                tool += ' <span class="light">/ ' + Craft.escapeHtml(value.mode) + '</span>';
            }
            // The tool cell is the row's detail trigger — a real <button>
            // so it is reachable and operable by keyboard (Space/Enter)
            // without depending on VueAdminTable row internals.
            return (
                '<button type="button" class="herald-activity-row-trigger" ' +
                'data-herald-activity-id="' + parseInt(value && value.id, 10) + '">' +
                tool +
                '</button>'
            );
        }

        function renderKindCell(value) {
            if (!value) {
                return '';
            }
            var cls = 'herald-status herald-status--' + value.replace(/_/g, '-');
            return '<span class="' + cls + '">' + Craft.escapeHtml(value) + '</span>';
        }

        function renderUserCell(value) {
            if (!value) {
                return '<span class="light">' + Craft.t('herald', 'Anonymous') + '</span>';
            }
            var label = Craft.escapeHtml(value.label || '');
            if (value.cpEditUrl) {
                return '<a href="' + Craft.escapeHtml(value.cpEditUrl) + '">' + label + '</a>';
            }
            return label;
        }

        function renderDurationCell(value) {
            var ms = parseInt(value, 10) || 0;
            if (ms < 1000) {
                return Craft.escapeHtml(ms + 'ms');
            }
            return Craft.escapeHtml((ms / 1000).toFixed(1) + 's');
        }

        function renderWhenCell(value) {
            if (!value) {
                return '';
            }
            var d = new Date(value);
            return Craft.escapeHtml(Craft.formatDate(d, 'short'));
        }

        var columns = [
            { name: 'tool', title: Craft.t('herald', 'Tool'), sortField: 'tool', callback: renderToolCell },
            { name: 'kind', title: Craft.t('herald', 'Kind'), sortField: 'kind', callback: renderKindCell },
            { name: 'user', title: Craft.t('herald', 'User'), callback: renderUserCell },
            { name: 'durationMs', title: Craft.t('herald', 'Duration'), sortField: 'durationMs', callback: renderDurationCell },
            { name: 'dateCreated', title: Craft.t('herald', 'When'), sortField: 'dateCreated', callback: renderWhenCell },
        ];

        var adminTable = new Craft.VueAdminTable({
            container: tableContainer,
            columns: columns,
            tableDataEndpoint: 'herald/settings/activity-table-data',
            // VueAdminTable has NO `criteria` option — custom params must
            // go through the `onQueryParams` hook, which fires on every
            // fetch. Reading the live DOM here means a filter change only
            // needs `.reload()` (gate-9 smoke caught the criteria config
            // being silently ignored).
            onQueryParams: function(params) {
                var filters = currentFilters();
                params['filters[kind]'] = filters.kind;
                params['filters[toolName]'] = filters.toolName;
                params['filters[userId]'] = filters.userId;
                params['filters[from]'] = filters.from;
                params['filters[to]'] = filters.to;
                return params;
            },
            search: true,
            searchPlaceholder: Craft.t('herald', 'Search activity'),
            emptyMessage: Craft.t('herald', 'No activity recorded yet.'),
        });

        // Filter changes just reload — `onQueryParams` re-reads the live
        // DOM values on the fetch it triggers.
        document.querySelectorAll('#herald-activity-filters select, #herald-activity-filters input').forEach(function(el) {
            el.addEventListener('change', function() {
                adminTable.reload();
            });
        });

        // Row-detail trigger — delegate at the document level so it
        // survives table re-renders (VueAdminTable replaces the row DOM on
        // every fetch). Locale-proof: matches the data attribute, not text.
        document.addEventListener('click', function(event) {
            var trigger = event.target.closest('.herald-activity-row-trigger[data-herald-activity-id]');
            if (!trigger) {
                return;
            }
            event.preventDefault();
            var id = parseInt(trigger.getAttribute('data-herald-activity-id'), 10);
            if (id > 0) {
                Herald.openActivityDetailSlideout(id);
            }
        });

        window.heraldActivityTable = adminTable;
    })();
{% endjs %}
