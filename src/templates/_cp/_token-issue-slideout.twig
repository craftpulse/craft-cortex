{% import "_includes/forms.twig" as forms %}

{# =========================================================================
   Token-issuance slideout body partial.

   Rendered by `actionTokenIssueSlideout` and fetched via
   `Craft.sendActionRequest('GET', 'herald/settings/token-issue-slideout')` from
   `Herald.openTokenIssuanceSlideout()`. The action returns
   `{html, headHtml, bodyHtml}` JSON: `html` is this fragment (passed into
   `new Craft.Slideout(html, {containerElement: 'form', ...})` — the
   slideout container supplies the `<form>` shell) and the head/body
   deltas carry the JS that `forms.elementSelectField` registers through
   the view (a bare-fragment response would ship the user picker dead).

   Two states share one fragment:
     1. `[data-herald-issue-form]` — the issue form (name, user, TTL).
        Visible on open.
     2. `[data-herald-reveal]`     — the one-time plaintext reveal.
        Hidden on open; the JS un-hides it and injects the plaintext
        into `[data-herald-token]` after `herald/settings/issue-token` returns
        200. The plaintext lives ONLY in this DOM node and the JSON
        response that produced it — never in a URL, a flash, or a log.

   No `<html>` / `<body>` chrome — pure fragment. The CSRF token is
   rendered inline because the slideout's form shell does not auto-inject
   it.
   ========================================================================= #}

<div class="so-body" data-herald-form>
    {# ---- State 1: issue form ------------------------------------------ #}
    <div data-herald-issue-form>
        <header class="pane-header">
            <h2 class="screen-title">{{ 'Issue bearer token'|t('herald') }}</h2>
        </header>

        <div class="so-content padded">
            <p class="light">
                {{ 'Mint a credential for the Streamable HTTP transport, bound to a Craft user. The plaintext is revealed once on the next screen and cannot be retrieved again.'|t('herald') }}
            </p>

            {{ csrfInput() }}

            {{ forms.textField({
                label: 'Name'|t('herald'),
                instructions: 'A human-readable label for the token. Leave blank to auto-name it.'|t('herald'),
                id: 'herald-token-name',
                name: 'name',
                autofocus: true,
                placeholder: 'claude-desktop'|t('herald'),
            }) }}

            {{ forms.elementSelectField({
                label: 'User'|t('herald'),
                instructions: 'The Craft user this token authenticates as. Tool calls run with this user’s permissions.'|t('herald'),
                id: 'herald-token-user',
                name: 'userId',
                elementType: 'craft\\elements\\User',
                limit: 1,
                required: true,
                selectionLabel: 'Choose a user'|t('herald'),
            }) }}

            {{ forms.textField({
                label: 'Expires in (seconds)'|t('herald'),
                instructions: 'Leave blank to use the plugin default ({default}).'|t('herald', {
                    default: settings.getTokenTtlDefault() ?? 'no expiry'|t('herald'),
                }),
                id: 'herald-token-ttl',
                name: 'ttlSeconds',
                type: 'number',
                min: 60,
                placeholder: settings.getTokenTtlDefault(),
            }) }}
        </div>

        <footer class="so-footer">
            <div class="flex flex-nowrap">
                <button type="button" class="btn" data-herald-cancel>{{ 'Cancel'|t('app') }}</button>
                <div class="flex-grow"></div>
                <button type="submit" class="btn submit" data-herald-submit>{{ 'Issue token'|t('herald') }}</button>
            </div>
        </footer>
    </div>

    {# ---- State 2: one-time plaintext reveal --------------------------- #}
    <div data-herald-reveal hidden>
        <header class="pane-header">
            <h2 class="screen-title">{{ 'Token issued'|t('herald') }}</h2>
        </header>

        <div class="so-content padded">
            <div class="readable">
                <blockquote class="note warning" role="alert">
                    {{ 'Copy this token now, it will not be shown again. Herald stores only a hash; there is no way to recover the plaintext later.'|t('herald') }}
                </blockquote>
            </div>

            <div class="field">
                <div class="heading">
                    <label id="herald-token-plaintext-label">{{ 'Bearer token'|t('herald') }}</label>
                </div>
                <div class="input">
                    <div class="flex flex-nowrap herald-token-reveal">
                        <code
                            class="herald-token-plaintext"
                            data-herald-token
                            aria-labelledby="herald-token-plaintext-label"
                        ></code>
                        <button
                            type="button"
                            class="btn"
                            data-herald-copy
                            aria-label="{{ 'Copy token to clipboard'|t('herald') }}"
                        >
                            <span data-icon="clipboard" aria-hidden="true"></span>
                            {{ 'Copy'|t('herald') }}
                        </button>
                    </div>
                </div>
            </div>

            {# Polite live region — announces the copy confirmation to
               assistive tech without stealing focus. #}
            <p
                class="visually-hidden"
                aria-live="polite"
                data-herald-copy-status
            ></p>
        </div>

        <footer class="so-footer">
            <div class="flex flex-nowrap">
                <div class="flex-grow"></div>
                <button type="button" class="btn submit" data-herald-done>{{ 'Done'|t('herald') }}</button>
            </div>
        </footer>
    </div>
</div>
