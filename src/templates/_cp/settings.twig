{% extends "cortex/_cp/_layout" %}
{% import "_includes/forms.twig" as forms %}

{# =========================================================================
   Cortex Settings screen.

   First screen in the Cortex CP section. Hosts project-config-synced
   plugin defaults: `craft_exec` toggle, dry-run default, runtime override
   TTL, and the allowed-commands browser.

   Runtime allowlist grants (DB-backed, time-bound) live on the "Temporary
   grants" screen — they share the issued-grant lifecycle of bearer
   tokens, not the project-config lifecycle of plugin defaults.

   The allowed-commands surface is TWO discoverable grouped toggle
   browsers — one over the content-level `settings[allowedCommands]`
   bucket, one over the admin-level `settings[adminLevelCommands]` bucket.
   Every console-command route (core + installed plugins) is enumerated by
   `Allowlist::getCommandGroups()`, grouped by controller, and tagged with
   its `adminLevel` classification (`Allowlist::isAdminLevelRoute()`); each
   browser renders only the groups of its class. A group-level lightswitch
   persists the group glob; per-action switches persist exact route ids; a
   partially-toggled group shows a "N/total allowed" badge. Patterns that
   don't map to a known group/action in a bucket — power-user globs,
   since-removed plugins — land in that bucket's "Custom patterns" editable
   table so they survive a round-trip. The controller folds each section's
   three sources into the correct setting via
   `Allowlist::patternsFromToggleState()`, with the bucket boundary
   enforced in the service.

   The admin-level bucket dispatches ONLY when `allowAdminChanges` is on;
   the security point of the split is that a content toggle can never
   surface an admin-level route into the always-admitted bucket.

   When either setting is locked by `config/cortex.php`
   (`allowedCommandsOverridden` / `adminLevelCommandsOverridden`), that
   browser renders read-only with Craft's standard "defined in config"
   treatment.

   Other form fields use `settings[xxx]` bracket naming so the controller's
   `getBodyParam('settings', [])` collects them as one map for
   `Craft::$app->getPlugins()->savePluginSettings()` — sidesteps the
   split-settings footgun from `cp.md` §"Split Settings Pages".

   Per locked decision 1 the save target is `cortex/settings/save`
   (own controller action), NOT Craft's `plugins/save-plugin-settings`.
   ========================================================================= #}

{% set selectedSubnavItem = 'settings' %}
{% set fullPageForm = true %}

{% do view.registerTranslations('cortex', [
    '{count}/{total} allowed',
    'Filter commands',
]) %}

{% block content %}
    {{ actionInput('cortex/settings/save') }}
    {{ redirectInput('settings/plugins/cortex') }}

    <h2>{{ 'Defaults'|t('cortex') }}</h2>

    <p class="light">
        {{ 'These options sync to project config and apply across environments.'|t('cortex') }}
    </p>

    {{ forms.lightswitchField({
        label: 'Enable craft_exec'|t('cortex'),
        instructions: 'Disable to remove the `craft_exec` tool from `tools/list` entirely. The tool is stdio-only and gated by six security checks regardless.'|t('cortex'),
        id: 'execEnabled',
        name: 'settings[execEnabled]',
        on: settings.execEnabled,
    }) }}

    {{ forms.lightswitchField({
        label: 'craft_exec defaults to dry-run'|t('cortex'),
        instructions: 'When enabled, `craft_exec` returns parsed analysis instead of evaluating until the caller passes `confirm: true`. Destructive expressions still need explicit `dangerous: true` regardless.'|t('cortex'),
        id: 'execDryRunDefault',
        name: 'settings[execDryRunDefault]',
        on: settings.execDryRunDefault,
    }) }}

    {{ forms.textField({
        label: 'Temporary grant TTL (seconds)'|t('cortex'),
        instructions: 'Default expiry applied to a new temporary grant when none is supplied at creation time. Default 7 days (604800).'|t('cortex'),
        id: 'runtimeOverrideTtl',
        name: 'settings[runtimeOverrideTtl]',
        value: settings.runtimeOverrideTtl,
        type: 'number',
        min: 60,
    }) }}

    <hr>

    <h2>{{ 'Content commands'|t('cortex') }}</h2>

    <p class="light">
        {{ 'Which content-level console commands the `craft_command` tool may dispatch. These touch content, caches, queues, or mail and are always admitted. Toggle a whole group, or expand it to allow individual actions. Patterns use `fnmatch` semantics: a group toggle saves `group/*`; an individual toggle saves the exact route id.'|t('cortex') }}
    </p>

    {{ _self.commandBrowser({
        groups: commandGroups|filter(g => not g.adminLevel),
        groupParam: 'cortexCommandGroups',
        actionParam: 'cortexCommandActions',
        customPatterns: contentCustomPatterns,
        customSetting: 'allowedCommands',
        disabled: allowedCommandsOverridden,
        overriddenMessage: 'The content-commands list is defined in `config/cortex.php` and can’t be edited here.'|t('cortex'),
    }) }}

    <hr>

    <h2>{{ 'Admin-level commands'|t('cortex') }}</h2>

    <p class="light">
        {{ 'Console commands that mutate admin-only state — project config, migrations, scaffolding, section/field schema, fixtures. These dispatch ONLY when `allowAdminChanges` is enabled in `config/general.php`; with it off, a matching `craft_command` call is rejected regardless of what is toggled here.'|t('cortex') }}
    </p>

    {% if not allowAdminChanges %}
        <p class="warning">
            {{ '`allowAdminChanges` is currently off, so none of these commands will dispatch even when toggled on. They are shown so you can pre-configure the admin-level surface.'|t('cortex') }}
        </p>
    {% endif %}

    {{ _self.commandBrowser({
        groups: commandGroups|filter(g => g.adminLevel),
        groupParam: 'cortexAdminCommandGroups',
        actionParam: 'cortexAdminCommandActions',
        customPatterns: adminCustomPatterns,
        customSetting: 'adminLevelCommands',
        disabled: adminLevelCommandsOverridden,
        overriddenMessage: 'The admin-level commands list is defined in `config/cortex.php` and can’t be edited here.'|t('cortex'),
    }) }}

{% endblock %}

{# =========================================================================
   Command-browser macro — one grouped toggle section over a pattern bucket.
   Rendered twice from the content block (content + admin-level). Each call
   gets its own toggle param namespace (`groupParam` / `actionParam`) and its
   own custom-patterns editable table keyed to its `customSetting`, so the
   controller folds each section into the correct setting. The shared JS in
   `initCommandBrowser` operates on DOM state, not param names, so both roots
   wire up identically.
   ========================================================================= #}
{% macro commandBrowser(cfg) %}
    {# Macros have isolated scope — the template-level `forms` import isn't
       visible here, and an imported macro namespace can't be passed as a
       bare argument. Re-import inside the macro body. #}
    {% import "_includes/forms.twig" as forms %}
    {% set browserDisabled = cfg.disabled %}

    {% if browserDisabled %}
        <p class="warning">{{ cfg.overriddenMessage }}</p>
    {% endif %}

    <div
        class="cortex-command-browser{{ browserDisabled ? ' cortex-command-browser--disabled' : '' }}"
        data-cortex-command-browser
        {{ browserDisabled ? 'aria-disabled="true"' : '' }}
    >
        <div class="cortex-command-search">
            <div class="texticon search icon clearable">
                <input
                    type="text"
                    class="text fullwidth"
                    autocomplete="off"
                    data-cortex-command-filter
                    placeholder="{{ 'Filter commands'|t('cortex') }}"
                    aria-label="{{ 'Filter commands'|t('cortex') }}"
                    {{ browserDisabled ? 'disabled' : '' }}
                >
            </div>
        </div>

        <div class="cortex-command-groups">
            {% for handle, group in cfg.groups %}
                <div
                    class="cortex-command-group"
                    data-cortex-command-group
                    data-group-handle="{{ handle }}"
                >
                    <div class="cortex-command-group-header">
                        <button
                            type="button"
                            class="cortex-command-group-toggle"
                            data-cortex-group-expand
                            aria-expanded="false"
                        >
                            <span class="cortex-command-group-caret" aria-hidden="true">▸</span>
                            <span class="cortex-command-group-name">{{ handle }}</span>
                            <span class="cortex-command-group-source light">{{ group.source }}</span>
                        </button>

                        <span
                            class="cortex-command-group-badge light"
                            data-cortex-group-badge
                            {{ group.fullToggle ? 'hidden' : '' }}
                        >
                            {{ '{count}/{total} allowed'|t('cortex', { count: group.allowedCount, total: group.totalCount }) }}
                        </span>

                        {{ forms.lightswitch({
                            id: cfg.groupParam ~ '-' ~ handle,
                            name: cfg.groupParam ~ '[' ~ handle ~ ']',
                            on: group.fullToggle,
                            disabled: browserDisabled,
                            value: '1',
                        }) }}
                    </div>

                    <div class="cortex-command-actions" data-cortex-command-actions hidden>
                        {% for action in group.actions %}
                            <div class="cortex-command-action" data-cortex-command-action data-route-id="{{ action.id }}">
                                <label class="cortex-command-action-label">
                                    <code class="cortex-token-prefix">{{ action.id }}</code>
                                </label>
                                {{ forms.lightswitch({
                                    id: cfg.actionParam ~ '-' ~ (action.id|replace({'/': '-'})),
                                    name: cfg.actionParam ~ '[' ~ action.id ~ ']',
                                    on: action.allowed,
                                    disabled: browserDisabled or group.fullToggle,
                                    value: '1',
                                    small: true,
                                }) }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Custom patterns — power-user globs and patterns for since-removed
       commands that don't map to any enumerated group/action in this
       bucket. Preserved verbatim so toggling the browser never silently
       drops them. Collapsed by default; auto-expanded when it has rows. #}
    <details class="cortex-custom-patterns" {{ cfg.customPatterns is not empty ? 'open' : '' }}>
        <summary>{{ 'Custom patterns'|t('cortex') }} ({{ cfg.customPatterns|length }})</summary>

        <p class="light">
            {{ 'Glob patterns that don’t map to a listed command — custom wildcards, or commands for plugins that aren’t installed here. Edited as raw `fnmatch` patterns and merged with the toggles above on save.'|t('cortex') }}
        </p>

        {{ forms.editableTable({
            id: cfg.customSetting,
            name: 'settings[' ~ cfg.customSetting ~ ']',
            cols: {
                pattern: {
                    heading: 'Pattern'|t('cortex'),
                    type: 'singleline',
                    code: true,
                },
            },
            rows: cfg.customPatterns|map(p => { pattern: p }),
            defaultValues: { pattern: '' },
            addRowLabel: 'Add a pattern'|t('cortex'),
            allowAdd: not browserDisabled,
            allowDelete: not browserDisabled,
            allowReorder: not browserDisabled,
            static: browserDisabled,
        }) }}
    </details>
{% endmacro %}

{% js %}
    (function() {
        if (!window.Cortex || typeof window.Cortex.initCommandBrowser !== 'function') {
            return;
        }
        var roots = document.querySelectorAll('[data-cortex-command-browser]');
        Array.prototype.forEach.call(roots, function(root) {
            window.Cortex.initCommandBrowser(root);
        });
    })();
{% endjs %}
