{% extends "herald/_cp/_layout" %}

{# =========================================================================
   Herald Temporary grants screen.

   Per-user, time-bound access an operator issues on top of the
   project-config Settings allowlist: a grant names the user it is FOR, the
   command scope(s) it covers, and an expiry. The craft_command dispatch
   gate honours a grant only for its subject.

   Layout:
     - "Issue grant" opens the guided slideout (user picker, grouped command
       picker, duration presets, reason).
     - Active grants render in the main VueAdminTable with a live expiry
       countdown and a per-row revoke.
     - Expired grants live in a collapsed "History" section (a second table)
       until Craft's gc reaps them.
     - "Effective allowlist right now" is a read-only status panel.

   Internal route paths, permission names, controller action names, and the
   `herald_runtime_overrides` table keep the `allowlist` / `override`
   wording. The row shape is locked in
   `SettingsController::_serializeOverrideRow`:
   `{id, pattern, note, expiresAt, createdBy, subject, dateCreated}`.

   Data path:
     - Table data : GET  herald/settings/allowlist-table-data?status=active|expired → JSON {pagination, data}
     - Slideout   : GET  herald/settings/allowlist-override-slideout → HTML fragment
     - Issue      : POST herald/settings/add-override  → JSON {model, models, message}
     - Revoke     : POST herald/settings/remove-override (VueAdminTable deleteAction) → JSON {message}
   ========================================================================= #}

{% set selectedSubnavItem = 'grants' %}

{% do view.registerTranslations('herald', [
    'Are you sure you want to revoke this grant?',
    'Commands',
    'Could not add grant.',
    'Could not open the grant form.',
    'Expired grants',
    'Expires in',
    'Global',
    'Grant issued.',
    'Grant revoked.',
    'Issue grant',
    'Issued',
    'Issued by',
    'Never',
    'No active grants.',
    'No expired grants.',
    'Reason',
    'Search grants',
    'Subject',
    'expired',
    'left',
]) %}

{% block content %}
    <p class="light">
        {{ 'Per-user, time-bound access to run additional `craft_command` commands. A grant applies only to its subject user and expires automatically. Revoke one early with the trash action.'|t('herald') }}
    </p>

    <div id="herald-allowlist-vue-admin-table"></div>

    {# ---------------------------------------------------------------------
       History — expired grants, still in the DB until Craft's gc reaps them.
       Collapsed by default; the second table only loads its data when the
       operator expands it.
       --------------------------------------------------------------------- #}
    <details class="herald-grant-history" style="margin-top: 18px;">
        <summary style="cursor: pointer; font-weight: 600;">
            {{ 'Expired grants'|t('herald') }}
        </summary>
        <div id="herald-allowlist-history-table" style="margin-top: 12px;"></div>
    </details>

    {# ---------------------------------------------------------------------
       Effective allowlist right now — the combined, deduplicated result the
       dispatcher sees: base Settings patterns plus every active grant.
       Read-only status panel.
       --------------------------------------------------------------------- #}
    <div class="pane" style="margin-top: 24px;">
        <h2>{{ 'Effective allowlist right now'|t('herald') }}</h2>
        <p class="light">
            {{ 'The deduplicated set of patterns the `craft_command` tool may dispatch this moment: the Settings allowlist plus every active grant.'|t('herald') }}
        </p>
        <p class="light">
            {{ 'Admin-level patterns only appear here while `allowAdminChanges` is enabled — it is currently {state}.'|t('herald', {
                state: allowAdminChanges ? 'on'|t('herald') : 'off'|t('herald'),
            }) }}
        </p>

        <table class="data fullwidth herald-table">
            <thead>
                <tr>
                    <th scope="col">{{ 'Pattern'|t('herald') }}</th>
                    <th scope="col">{{ 'Source'|t('herald') }}</th>
                    <th scope="col">{{ 'Expires'|t('herald') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for pattern in effective %}
                    {% set grantExpiry = grantExpiryByPattern[pattern] ?? null %}
                    {% set isAdminLevel = adminLevelPatterns[pattern] ?? false %}
                    <tr>
                        <td><code class="herald-token-prefix">{{ pattern }}</code></td>
                        <td>
                            {% if grantExpiry is not null %}
                                {{ 'Grant'|t('herald') }}
                            {% elseif isAdminLevel %}
                                {{ 'Admin-level'|t('herald') }}
                            {% else %}
                                <span class="light">{{ 'Settings'|t('herald') }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if grantExpiry is not null %}
                                {{ grantExpiry|datetime('short') }}
                            {% else %}
                                <span class="light">{{ 'Never'|t('herald') }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% js %}
    (function() {
        function renderSubjectCell(value) {
            // Null subject = a global grant that applies to every caller.
            if (!value) {
                return '<span class="light">' + Craft.t('herald', 'Global') + '</span>';
            }
            var label = Craft.escapeHtml(value.label || '');
            if (value.cpEditUrl) {
                return '<a href="' + Craft.escapeHtml(value.cpEditUrl) + '">' + label + '</a>';
            }
            return label;
        }

        function renderPatternCell(value) {
            var pattern = Craft.escapeHtml((value && value.pattern) || '');
            var muted = value && value.isExpired ? ' style="opacity:0.55"' : '';
            return '<code class="herald-token-prefix"' + muted + '>' + pattern + '</code>';
        }

        function renderNoteCell(value) {
            if (!value) {
                return '<span class="light">-</span>';
            }
            return Craft.escapeHtml(value);
        }

        function renderExpiresCell(value) {
            if (!value || !value.value) {
                return '<span class="light">' + Craft.t('herald', 'Never') + '</span>';
            }
            // Live countdown span — Herald.refreshCountdowns() fills it and
            // keeps it ticking. data-expires is the naive-UTC stored value.
            return (
                '<span class="herald-countdown" data-herald-countdown data-expires="' +
                Craft.escapeHtml(value.value) +
                '"></span>'
            );
        }

        function renderCreatedByCell(value) {
            if (!value) {
                return '<span class="light">-</span>';
            }
            var label = Craft.escapeHtml(value.label || '');
            if (value.cpEditUrl) {
                return '<a href="' + Craft.escapeHtml(value.cpEditUrl) + '">' + label + '</a>';
            }
            return label;
        }

        function renderDateCreatedCell(value) {
            if (!value) {
                return '';
            }
            return Craft.escapeHtml(Craft.formatDate(new Date(value), 'short'));
        }

        function columns() {
            return [
                { name: 'subject', title: Craft.t('herald', 'Subject'), callback: renderSubjectCell },
                { name: 'pattern', title: Craft.t('herald', 'Commands'), sortField: 'pattern', callback: renderPatternCell },
                { name: 'note', title: Craft.t('herald', 'Reason'), callback: renderNoteCell },
                { name: 'expiresAt', title: Craft.t('herald', 'Expires in'), sortField: 'expiresAt', callback: renderExpiresCell },
                { name: 'createdBy', title: Craft.t('herald', 'Issued by'), callback: renderCreatedByCell },
                { name: 'dateCreated', title: Craft.t('herald', 'Issued'), sortField: 'dateCreated', callback: renderDateCreatedCell },
            ];
        }

        var adminTable = new Craft.VueAdminTable({
            container: '#herald-allowlist-vue-admin-table',
            columns: columns(),
            tableDataEndpoint: 'herald/settings/allowlist-table-data?status=active',
            deleteAction: 'herald/settings/remove-override',
            deleteConfirmationMessage: Craft.t('herald', 'Are you sure you want to revoke this grant?'),
            deleteSuccessMessage: Craft.t('herald', 'Grant revoked.'),
            emptyMessage: Craft.t('herald', 'No active grants.'),
            search: true,
            searchPlaceholder: Craft.t('herald', 'Search grants'),
            buttons: [
                {
                    label: Craft.t('herald', 'Issue grant'),
                    icon: 'plus',
                    href: '#herald-allowlist-add-override',
                    enabled: function() { return true; },
                },
            ],
            onData: function() { window.Herald.startCountdowns(); },
        });

        var historyTable = new Craft.VueAdminTable({
            container: '#herald-allowlist-history-table',
            columns: columns(),
            tableDataEndpoint: 'herald/settings/allowlist-table-data?status=expired',
            deleteAction: 'herald/settings/remove-override',
            deleteConfirmationMessage: Craft.t('herald', 'Are you sure you want to revoke this grant?'),
            deleteSuccessMessage: Craft.t('herald', 'Grant revoked.'),
            emptyMessage: Craft.t('herald', 'No expired grants.'),
            search: true,
            searchPlaceholder: Craft.t('herald', 'Search grants'),
            onData: function() { window.Herald.startCountdowns(); },
        });

        // Anchor-based trigger for the guided slideout — locale-proof
        // (the button renders as <a href="#...">).
        document.addEventListener('click', function(event) {
            var target = event.target.closest('a[href="#herald-allowlist-add-override"]');
            if (!target) {
                return;
            }
            event.preventDefault();
            window.Herald.openAllowlistOverrideSlideout(adminTable);
        });

        window.heraldAllowlistTable = adminTable;
        window.heraldAllowlistHistoryTable = historyTable;
        window.Herald.startCountdowns();
    })();
{% endjs %}
